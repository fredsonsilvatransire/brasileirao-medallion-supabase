# Copie para .env e preencha. NUNCA versione o arquivo .env.

# Supabase > Project Settings > Data API
SUPABASE_URL=https://<project-ref>.supabase.co
# Chave pública (somente leitura via RLS) — pode ir para o dashboard
SUPABASE_ANON_KEY=
# Chave administrativa — uso exclusivo do pipeline local / GitHub Secrets
SUPABASE_SERVICE_ROLE_KEY=

# Supabase > Project Settings > Database > Connection string (Session pooler)
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:5432/postgres
